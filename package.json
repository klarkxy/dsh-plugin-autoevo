{
  "name": "dsh-plugin-autoevo",
  "version": "1.3.1",
  "private": true,
  "description": "Lightweight capability discovery, review, and installation workflow for DSH.",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.29.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klarkxy/dsh-plugin-autoevo.git"
  },
  "bugs": {
    "url": "https://github.com/klarkxy/dsh-plugin-autoevo/issues"
  },
  "homepage": "https://github.com/klarkxy/dsh-plugin-autoevo#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "deepseek-harness",
    "capability-reuse"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./evolution-mode": {
      "types": "./lib/evolution-mode.d.ts",
      "import": "./lib/evolution-mode.js",
      "default": "./lib/evolution-mode.js"
    },
    "./verification-observer": {
      "types": "./lib/verification-observer.d.ts",
      "import": "./lib/verification-observer.js",
      "default": "./lib/verification-observer.js"
    }
  },
  "files": [
    "lib",
    "skills",
    "presets",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/user-guide.md",
    "docs/user-guide.en.md",
    "docs/developer-guide.md",
    "docs/developer-guide.en.md",
    "docs/architecture.md",
    "docs/security.md",
    "docs/assets/kanban.png",
    "docs/assets/flowcharts",
    "example/README.md",
    "example/create",
    "example/auto-review",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || ^24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:loader": "node tests/loader-smoke.mjs",
    "test:packaged": "node tests/packaged-acceptance.mjs",
    "test:e2e:local": "node tests/e2e-runner.mjs resolve-local",
    "test:e2e:adversarial": "node tests/e2e-runner.mjs adversarial-define",
    "test:e2e:marketplace": "node tests/e2e-runner.mjs marketplace-flow",
    "test:e2e:offline": "pnpm test:e2e:local && pnpm test:e2e:adversarial",
    "test:e2e:live": "pnpm test:e2e:marketplace",
    "test:e2e": "pnpm test:e2e:offline && pnpm test:e2e:live",
    "test:acceptance": "pnpm test:loader && pnpm test:packaged && pnpm test:e2e:offline",
    "check:fast": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check": "pnpm check:fast",
    "check:release": "pnpm check:fast && pnpm test:integration && pnpm test:acceptance && pnpm test:e2e:live && pnpm pack:dry-run",
    "pack:dry-run": "pnpm pack --dry-run"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/schemastery": "3.18.1",
    "semver": "7.8.5",
    "tar": "7.5.22",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-fs": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-sandbox": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-skill": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-subprocess": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-user-approval": ">=0.1.0-rc.6 <0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.1.1-rc.2",
    "@deepseek-ai/dsh-code-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs-sandbox": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-loader-smoke": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.1-rc.2",
    "@types/node": "24.3.0",
    "@types/semver": "7.7.0",
    "@typescript-eslint/parser": "8.41.0",
    "eslint": "9.34.0",
    "tsdown": "0.22.14",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
